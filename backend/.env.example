# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://velozity:velozity@localhost:5432/velozity?schema=public"

# Auth
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Set COOKIE_SECURE=false when serving over plain HTTP (e.g. Docker demo).
COOKIE_SECURE=